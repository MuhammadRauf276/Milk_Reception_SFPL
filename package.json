{
  "name": "milk-reception-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n \"NEXT,WHATSAPP\" -c \"cyan,green\" \"next dev\" \"node scripts/whatsapp_service.js\"",
    "dev:next": "next dev",
    "dev:whatsapp": "node scripts/whatsapp_service.js",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint src/components/ui/ src/frontend/hooks/useVisualViewport.ts src/frontend/hooks/__tests__/ scripts/verify-component-primitives.ts scripts/verify-responsive-viewports.ts scripts/verify-operational-workflows.ts scripts/seed-synthetic-test-workflows.ts src/backend/services/__tests__/approvalAuthorization.test.ts --max-warnings=0",
    "check:ui-text": "node scripts/check-ui-text.js",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "whatsapp:gateway": "node scripts/whatsapp_service.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:unit": "tsx --test src/components/ui/__tests__/*.ts src/frontend/hooks/__tests__/*.ts src/backend/services/__tests__/approvalAuthorization.test.ts",
    "test:components": "tsx scripts/verify-component-primitives.ts",
    "test:viewports": "tsx scripts/verify-responsive-viewports.ts",
    "test:workflows": "tsx scripts/verify-operational-workflows.ts",
    "verify:phase2": "npm run typecheck && npm run lint && npm run check:ui-text && npm run test:unit && npm run test:components && npm run test:viewports && npm run test:workflows && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.104.5",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.4.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "6.15.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "playwright": "^1.64.1",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  }
}
