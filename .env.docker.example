# ==============================================================================
# Milk Reception System - Production Environment Configuration for Docker & VM
# ==============================================================================

# PostgreSQL Credentials (used by both Postgres container and Next.js Prisma connection)
POSTGRES_DB=milk_reception_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_password_123

# JWT Secret for Session & Authentication Tokens (Must be at least 32 characters)
JWT_SECRET=production-secret-token-replace-with-random-32-chars-key-here

# Public URL of the application as reached by client browsers (IP address or domain of the VM)
# Example: http://192.168.1.100:3000 or http://milk.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev profiles on login screen. Set "true" if demo/testing in VM, or "false" for strict production.
NEXT_PUBLIC_ENABLE_DEV_LOGIN_PROFILES=false

# Port mapping on the host VM
APP_PORT=3000
WHATSAPP_PORT=3001

# Shared secret for scheduled / cron endpoints (optional)
CRON_SECRET=

# Shared secret between Next.js and WhatsApp gateway daemon (optional)
WHATSAPP_GATEWAY_SECRET=

# Set to "true" on first launch if you want Docker to automatically run Prisma seed data
RUN_SEED=false
