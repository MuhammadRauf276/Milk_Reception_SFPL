<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Native Status Bar Overlay for Offline & GPS Feedback -->
    <LinearLayout
        android:id="@+id/nativeStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1E293B"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivGpsIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/presence_online"
            android:contentDescription="GPS Status" />

        <TextView
            android:id="@+id/tvNativeGpsStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="GPS Foreground Tracking Active" />

        <TextView
            android:id="@+id/tvOfflineQueueCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#EF4444"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:text="0 Unsent" />
    </LinearLayout>

    <!-- Embedded High-Performance WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/nativeStatusBar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Progress Indicator on Initial Load -->
    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
