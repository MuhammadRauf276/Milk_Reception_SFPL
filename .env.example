# PostgreSQL Connection String for Development / Runtime
DATABASE_URL="postgresql://username:password@localhost:5432/milk_reception_db"

# Dedicated PostgreSQL Connection String for Automated Vitest / Regression Testing
# Must be distinct from DATABASE_URL and database name must contain 'test'
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/milk_reception_test"

# JWT Secret Key
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
