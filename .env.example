# PostgreSQL Connection String for Development / Runtime
DATABASE_URL="postgresql://username:password@localhost:5432/milk_reception_db"

# JWT Secret Key
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dev-only one-click login cards (ignored when NODE_ENV=production). Keep OFF everywhere except local dev.
NEXT_PUBLIC_ENABLE_DEV_LOGIN_PROFILES="false"

# Bearer secret for schedulers calling /api/cron/process-sms and /api/revalidate (use a long random value)
CRON_SECRET=""

# Optional shared secret between Next.js and scripts/whatsapp_service.js (set the same value in both processes)
WHATSAPP_GATEWAY_SECRET=""
