# HTTPS in front of the app.
#
# Why: phone browsers refuse to give a web page the GPS position unless the page is opened over HTTPS.
# (The Android app reads GPS itself and is not affected; this is for people who use the browser.)
#
# Caddy gets and renews the certificate by itself. Set these in .env:
#
#   APP_DOMAIN   The name people type to open the app.
#   APP_TLS      "internal"            -> Caddy makes its own certificate (office network only).
#                                         Each phone must install Caddy's root certificate once.
#                an email address      -> a free public certificate (Let's Encrypt). Needs a real domain
#                                         name that points at this server, reachable from the internet
#                                         on ports 80 and 443. Phones need nothing installed.
#   APP_UPSTREAM Where the app listens. "app:3000" in Docker; "localhost:3000" when the app runs directly.
#
# Start with Docker:   docker compose --profile https up -d
# Start without Docker: caddy run --config Caddyfile   (with the three values set in the environment)

{$APP_DOMAIN:localhost} {
	encode zstd gzip
	tls {$APP_TLS:internal}

	# Tells the app the visitor came in over HTTPS, so the sign-in cookie is marked secure.
	reverse_proxy {$APP_UPSTREAM:app:3000}

	header {
		Strict-Transport-Security "max-age=31536000"
	}
}
