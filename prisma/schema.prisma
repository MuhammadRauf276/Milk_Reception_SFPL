  operational_date          DateTime  @map("operational_date") @db.Date
  client_event_id           String    @unique @map("client_event_id") @db.VarChar(255)
  quantity_value            Decimal   @map("quantity_value") @db.Decimal(10, 2)
  quantity_unit             String    @map("quantity_unit") @db.VarChar(10)
  gross_liters              Decimal   @map("gross_liters") @db.Decimal(10, 2)
  density                   Decimal   @map("density") @db.Decimal(6, 4)
  lr                        Decimal   @map("lr") @db.Decimal(5, 2)
  fat                       Decimal   @map("fat") @db.Decimal(4, 2)
  snf                       Decimal   @map("snf") @db.Decimal(5, 2)
  ts                        Decimal   @map("ts") @db.Decimal(5, 2)
  at_13ts_liters            Decimal   @map("at_13ts_liters") @db.Decimal(10, 2)
  calculation_version       String    @default("1.0") @map("calculation_version") @db.VarChar(20)
  collection_latitude       Decimal   @map("collection_latitude") @db.Decimal(10, 7)
  collection_longitude      Decimal   @map("collection_longitude") @db.Decimal(10, 7)
  collection_gps_accuracy   Decimal?  @map("collection_gps_accuracy") @db.Decimal(8, 2)
  device_collected_at       DateTime  @map("device_collected_at") @db.Timestamp(6)
  server_received_at        DateTime  @default(now()) @map("server_received_at") @db.Timestamp(6)
  submitted_by_user_id      BigInt    @map("submitted_by_user_id")
  collection_notes          String?   @map("collection_notes") @db.Text
  shop_rmr_number           String?   @map("shop_rmr_number") @db.VarChar(50)
  milk_source_id            BigInt?   @map("milk_source_id")
  milk_source_code_snapshot String?   @map("milk_source_code_snapshot") @db.VarChar(50)
  milk_source_name_snapshot String?   @map("milk_source_name_snapshot") @db.VarChar(150)
  correction_count          Int       @default(0) @map("correction_count")
  manager_correction_count  Int       @default(0) @map("manager_correction_count")
  last_corrected_by_user_id BigInt?   @map("last_corrected_by_user_id")
  last_corrected_at         DateTime? @map("last_corrected_at") @db.Timestamp(6)
  created_at                DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  // Phase 2: decision rules (plan §3 Stage 1, §14) - same column set as ZmccLabPortion
  system_outcome        String?   @map("system_outcome") @db.VarChar(20) // PASS | FAIL (server computed)
  person_decision       String?   @map("person_decision") @db.VarChar(20) // ACCEPT | REJECT
  decision_remarks      String?   @map("decision_remarks") @db.Text
  exception_reasons     Json?     @map("exception_reasons") @db.JsonB // ["MISMATCH","PICTURE_MISSING","RULE_FAIL:FAT",...]
  review_status         String    @default("NONE") @map("review_status") @db.VarChar(20) // NONE | PENDING | APPROVED | REJECTED
  reviewed_by_user_id   BigInt?   @map("reviewed_by_user_id")
  reviewed_as_role      String?   @map("reviewed_as_role") @db.VarChar(64)
  reviewed_is_delegated Boolean   @default(false) @map("reviewed_is_delegated")
  reviewed_at           DateTime? @map("reviewed_at") @db.Timestamp(6)
  review_remarks        String?   @map("review_remarks") @db.Text
  final_decision        String    @default("ACCEPTED") @map("final_decision") @db.VarChar(20) // ACCEPTED | REJECTED | PENDING
  performed_as_role     String?   @map("performed_as_role") @db.VarChar(64) // role the submitter acted as
  is_delegated          Boolean   @default(false) @map("is_delegated")

  // Phase 4a: Stage 1 decision snapshot (policy version, per-test outcomes, geofence, warnings)
  decision_details Json? @map("decision_details") @db.JsonB

  // Relations
  journey           MotJourney              @relation(fields: [journey_id], references: [id], onDelete: Restrict)
  stop              MotJourneyStop          @relation(fields: [journey_stop_id], references: [id], onDelete: Restrict)
  shop              ZmccShop                @relation("ZmccShopMotCollections", fields: [shop_id], references: [id], onDelete: Restrict)
  zmcc              ProcurementSource       @relation("ZmccMotCollections", fields: [zmcc_id], references: [id], onDelete: Restrict)
  route             ZmccRoute               @relation("ZmccRouteMotCollections", fields: [route_id], references: [id], onDelete: Restrict)
  mot_profile       MotProfile              @relation("MotProfileCollections", fields: [mot_profile_id], references: [id], onDelete: Restrict)
  mot_vehicle       MotVehicle              @relation("MotVehicleCollections", fields: [mot_vehicle_id], references: [id], onDelete: Restrict)
  submitted_by      User                    @relation("MotCollectionSubmittedBy", fields: [submitted_by_user_id], references: [id], onDelete: Restrict)
  last_corrected_by User?                   @relation("MotCollectionLastCorrectedBy", fields: [last_corrected_by_user_id], references: [id], onDelete: SetNull)
  sms_outbox        MotCollectionSmsOutbox?
  milk_source       ZmccMilkSource?         @relation(fields: [milk_source_id], references: [id], onDelete: SetNull)
  reviewed_by       User?                   @relation("MotCollectionReviewedBy", fields: [reviewed_by_user_id], references: [id], onDelete: SetNull)

  version Int @default(1) @map("version")

  @@unique([journey_id, journey_stop_id])
  @@index([journey_id])
  @@index([shop_id])
  @@index([zmcc_id])
  @@index([milk_source_id])
  @@index([operational_date])
  @@index([shop_rmr_number])
  @@index([review_status])
  @@index([final_decision])
  @@index([zmcc_id, review_status])
  @@map("mot_shop_collection")
}

