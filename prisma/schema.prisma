// Prisma schema for Milk Reception & Process Logs Application
// Configured for PostgreSQL 18 with multi-relational ERD schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    BigInt    @id @default(autoincrement())
  full_name             String?   @map("full_name") @db.VarChar(255)
  username              String    @unique @db.VarChar(255)
  email                 String?   @map("email") @db.VarChar(254)
  password_hash         String?   @map("password_hash") @db.Text
  role                  String    @db.VarChar(255)
  department            String?   @map("department") @db.VarChar(150)
  scope_type            String    @default("ALL") @map("scope_type") @db.VarChar(50)
  procurement_source_id BigInt?   @map("procurement_source_id")
  is_active             Boolean   @default(true) @map("is_active")
  last_login_at         DateTime? @map("last_login_at") @db.Timestamp(6)
  created_at            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at            DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Phase 2: photo stamp ID + first-login flow (plan §9.3, §17)
  employee_code        String? @unique @map("employee_code") @db.VarChar(30)
  must_change_password Boolean @default(false) @map("must_change_password")

  // Relations
  procurement_source                          ProcurementSource?                     @relation("SourceUsers", fields: [procurement_source_id], references: [id], onDelete: SetNull)
  created_visits                              VehicleVisit[]                         @relation("CreatedBy")
  recorded_dispatches                         DispatchInfo[]                         @relation("RecordedBy")
  handled_entry_gates                         GateLog[]                              @relation("EntryGuard")
  handled_exit_gates                          GateLog[]                              @relation("ExitGuard")
  dispatch_lab_results                        DispatchLabResult[]                    @relation("DispatchTestedBy")
  plant_lab_results                           PlantLabResult[]                       @relation("PlantTestedBy")
  plant_decided_portions                      VisitPortion[]                         @relation("PlantDecidedBy")
  gross_weight_tickets                        WeightTicket[]                         @relation("GrossRecordedBy")
  tare_weight_tickets                         WeightTicket[]                         @relation("TareRecordedBy")
  started_unloadings                          UnloadingLog[]                         @relation("StartedBy")
  completed_unloadings                        UnloadingLog[]                         @relation("CompletedBy")
  audit_logs                                  AuditLog[]                             @relation("AuditUser")
  started_qa_sessions                         QATestingSession[]                     @relation("QAStartedBy")
  completed_qa_sessions                       QATestingSession[]                     @relation("QACompletedBy")
  qa_session_events                           QATestingSessionEvent[]                @relation("QASessionEventUser")
  created_silos                               Silo[]                                 @relation("SiloCreatedBy")
  updated_silos                               Silo[]                                 @relation("SiloUpdatedBy")
  inventory_transactions                      SiloInventoryTransaction[]             @relation("InventoryPerformedBy")
  created_warnings                            QAWarning[]                            @relation("WarningCreatedBy")
  acknowledged_warnings                       QAWarning[]                            @relation("WarningAcknowledgedBy")
  created_zmcc_routes                         ZmccRoute[]                            @relation("ZmccRouteCreatedBy")
  updated_zmcc_routes                         ZmccRoute[]                            @relation("ZmccRouteUpdatedBy")
  created_zmcc_areas                          ZmccArea[]                             @relation("ZmccAreaCreatedBy")
  updated_zmcc_areas                          ZmccArea[]                             @relation("ZmccAreaUpdatedBy")
  created_zmcc_milk_sources                   ZmccMilkSource[]                       @relation("ZmccMilkSourceCreatedBy")
  updated_zmcc_milk_sources                   ZmccMilkSource[]                       @relation("ZmccMilkSourceUpdatedBy")
  created_chiller_ownerships                  ChillerOwnership[]                     @relation("ChillerOwnershipCreatedBy")
  updated_chiller_ownerships                  ChillerOwnership[]                     @relation("ChillerOwnershipUpdatedBy")
  created_zmcc_shops                          ZmccShop[]                             @relation("ZmccShopCreatedBy")
  updated_zmcc_shops                          ZmccShop[]                             @relation("ZmccShopUpdatedBy")
  created_mot_profiles                        MotProfile[]                           @relation("MotProfileCreatedBy")
  updated_mot_profiles                        MotProfile[]                           @relation("MotProfileUpdatedBy")
  recorded_mot_arrivals                       ZmccMotArrival[]                       @relation("ZmccMotArrivalRecordedBy")
  mot_profile                                 MotProfile?                            @relation("MotProfileUser")
  created_mot_vehicles                        MotVehicle[]                           @relation("MotVehicleCreatedBy")
  updated_mot_vehicles                        MotVehicle[]                           @relation("MotVehicleUpdatedBy")
  assigned_mot_journeys                       MotJourney[]                           @relation("MotJourneyAssignedBy")
  cancelled_mot_journeys                      MotJourney[]                           @relation("MotJourneyCancelledBy")
  recorded_mot_locations                      MotJourneyLocation[]                   @relation("MotJourneyLocationRecordedBy")
  submitted_mot_collections                   MotShopCollection[]                    @relation("MotCollectionSubmittedBy")
  started_zmcc_lab_sessions                   ZmccLabSession[]                       @relation("ZmccLabStartedBy")
  completed_zmcc_lab_sessions                 ZmccLabSession[]                       @relation("ZmccLabCompletedBy")
  last_corrected_zmcc_lab_sessions            ZmccLabSession[]                       @relation("ZmccLabLastCorrectedBy")
  recommended_zmcc_lab_sessions               ZmccLabSession[]                       @relation("ZmccLabAttendantRecommendationBy")
  final_decided_zmcc_lab_sessions             ZmccLabSession[]                       @relation("ZmccLabFinalDecisionBy")
  created_milk_test_policies                  MilkTestPolicyAssignment[]             @relation("TestPolicyCreatedBy")
  updated_milk_test_policies                  MilkTestPolicyAssignment[]             @relation("TestPolicyUpdatedBy")
  created_zmcc_tanks                          ZmccTank[]                             @relation("ZmccTankCreatedBy")
  updated_zmcc_tanks                          ZmccTank[]                             @relation("ZmccTankUpdatedBy")
  received_zmcc_tank_receipts                 ZmccTankReceipt[]                      @relation("ZmccTankReceivedBy")
  last_corrected_zmcc_tank_receipts           ZmccTankReceipt[]                      @relation("ZmccTankReceiptLastCorrectedBy")
  performed_zmcc_tank_transactions            ZmccTankInventoryTransaction[]         @relation("ZmccTankTransactionPerformedBy")
  created_local_suppliers                     ZmccLocalSupplier[]                    @relation("LocalSupplierCreatedBy")
  updated_local_suppliers                     ZmccLocalSupplier[]                    @relation("LocalSupplierUpdatedBy")
  recorded_local_supplier_arrivals            ZmccLocalSupplierArrival[]             @relation("ZmccLocalSupplierArrivalRecordedBy")
  exited_mot_arrivals                         ZmccMotArrival[]                       @relation("ZmccMotArrivalExitRecordedBy")
  exited_local_supplier_arrivals              ZmccLocalSupplierArrival[]             @relation("ZmccLocalSupplierArrivalExitRecordedBy")
  updated_paper_policies                      PaperReferencePolicy[]                 @relation("PaperPolicyUpdatedBy")
  plant_corrected_portions                    VisitPortion[]                         @relation("PlantCorrectedBy")
  plant_reviewed_portions                     VisitPortion[]                         @relation("PlantPortionReviewedBy")
  plant_review_requested_portions             VisitPortion[]                         @relation("PlantPortionReviewRequestedBy")
  zmcc_reviewed_sessions                      ZmccLabSession[]                       @relation("ZmccSessionReviewedBy")
  zmcc_review_requested_sessions              ZmccLabSession[]                       @relation("ZmccSessionReviewRequestedBy")
  last_corrected_mot_arrivals                 ZmccMotArrival[]                       @relation("ZmccMotArrivalLastCorrectedBy")
  exit_last_corrected_mot_arrivals            ZmccMotArrival[]                       @relation("ZmccMotArrivalExitLastCorrectedBy")
  last_corrected_local_supplier_arrivals      ZmccLocalSupplierArrival[]             @relation("ZmccLocalSupplierArrivalLastCorrectedBy")
  exit_last_corrected_local_supplier_arrivals ZmccLocalSupplierArrival[]             @relation("ZmccLocalSupplierArrivalExitLastCorrectedBy")
  last_corrected_mot_collections              MotShopCollection[]                    @relation("MotCollectionLastCorrectedBy")
  last_corrected_visits                       VehicleVisit[]                         @relation("VehicleVisitLastCorrectedBy")
  issued_local_supplier_rmrs                  LocalSupplierRmrIssuance[]             @relation("LocalSupplierRmrIssuedBy")
  cancelled_local_supplier_rmrs               LocalSupplierRmrIssuance[]             @relation("LocalSupplierRmrCancelledBy")
  reviewed_legacy_local_supplier_rmrs         LocalSupplierRmrLegacyClassification[] @relation("LocalSupplierRmrLegacyReviewedBy")
  requested_corrections                       CorrectionRequest[]                    @relation("CorrectionRequestedBy")
  reviewed_corrections                        CorrectionRequest[]                    @relation("CorrectionReviewedBy")
  notifications                               Notification[]                         @relation("NotificationRecipient")
  notification_preferences                    NotificationPreference?
  push_subscriptions                          PushSubscription[]

  // Phase 2 back-relations
  registered_devices               Device[]                  @relation("DeviceRegisteredBy")
  blocked_devices                  Device[]                  @relation("DeviceBlockedBy")
  assigned_devices                 Device[]                  @relation("DeviceAssignedUser")
  device_activity_events           DeviceActivityEvent[]     @relation("DeviceActivityUser")
  station_pins                     StationPin[]              @relation("StationPinUser")
  captured_photos                  CapturedPhoto[]           @relation("PhotoCapturedBy")
  test_point_policy_changes        TestPointPolicy[]         @relation("TestPointPolicyChangedBy")
  config_changes                   ConfigChangeLog[]         @relation("ConfigChangeChangedBy")
  config_changes_approved          ConfigChangeLog[]         @relation("ConfigChangeApprovedBy")
  mot_collections_reviewed         MotShopCollection[]       @relation("MotCollectionReviewedBy")
  zmcc_shops_location_verified     ZmccShop[]                @relation("ZmccShopLocationVerifiedBy")
  local_suppliers_approved         ZmccLocalSupplier[]       @relation("LocalSupplierApprovedBy")
  lab_portions_created             ZmccLabPortion[]          @relation("ZmccLabPortionCreatedBy")
  lab_portions_reviewed            ZmccLabPortion[]          @relation("ZmccLabPortionReviewedBy")
  lab_portions_first_weighed       ZmccLabPortion[]          @relation("ZmccLabPortionFirstWeighedBy")
  lab_portions_second_weighed      ZmccLabPortion[]          @relation("ZmccLabPortionSecondWeighedBy")
  rejected_milk_dispositions       RejectedMilkDisposition[] @relation("RejectedMilkDispositionDecidedBy")
  vehicle_visit_approval_requests  VehicleVisit[]            @relation("VehicleVisitApprovalRequestedBy")
  vehicle_visit_approval_decisions VehicleVisit[]            @relation("VehicleVisitApprovalDecidedBy")
  seal_checked_portions            VisitPortion[]            @relation("PortionSealCheckedBy")
  gate_wash_checks                 GateLog[]                 @relation("GateWashCheckedBy")
  mpd_dispositioned_portions       VisitPortion[]            @relation("VisitPortionMpdDispositionBy")
  gate_wash_checked_by             GateLog[]                 @relation("GateWashedCheckedBy")
  visit_portions_first_weighed     VisitPortion[]            @relation("VisitPortionFirstWeighedBy")
  visit_portions_second_weighed    VisitPortion[]            @relation("VisitPortionSecondWeighedBy")

  @@map("users")
}

model VehicleVisit {
  id                    BigInt    @id @default(autoincrement())
  visit_number          String    @unique @map("visit_number") @db.VarChar(255)
  reception_number      String?   @unique @map("reception_number") @db.VarChar(255)
  vehicle_number        String    @map("vehicle_number") @db.VarChar(255)
  token_number          String?   @map("token_number") @db.VarChar(255)
  operational_date      DateTime? @map("operational_date") @db.Date
  current_status        String    @default("DISPATCHED") @map("current_status") @db.VarChar(255)
  created_by            BigInt?   @map("created_by")
  procurement_source_id BigInt?   @map("procurement_source_id")
  created_at            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at            DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  vehicle_dispatch_quantity_value      Decimal?          @map("vehicle_dispatch_quantity_value") @db.Decimal(10, 2)
  vehicle_dispatch_quantity_unit       QuantityUnit?     @map("vehicle_dispatch_quantity_unit")
  vehicle_dispatch_quantity_basis      MeasurementBasis? @map("vehicle_dispatch_quantity_basis")
  vehicle_dispatch_lr                  Decimal?          @map("vehicle_dispatch_lr") @db.Decimal(6, 2)
  vehicle_dispatch_fat                 Decimal?          @map("vehicle_dispatch_fat") @db.Decimal(5, 2)
  vehicle_dispatch_density             Decimal?          @map("vehicle_dispatch_density") @db.Decimal(6, 4)
  vehicle_dispatch_gross_liters        Decimal?          @map("vehicle_dispatch_gross_liters") @db.Decimal(12, 2)
  vehicle_dispatch_snf                 Decimal?          @map("vehicle_dispatch_snf") @db.Decimal(6, 2)
  vehicle_dispatch_ts                  Decimal?          @map("vehicle_dispatch_ts") @db.Decimal(6, 2)
  vehicle_dispatch_at_13ts_liters      Decimal?          @map("vehicle_dispatch_at_13ts_liters") @db.Decimal(12, 2)
  vehicle_dispatch_calculation_version String?           @map("vehicle_dispatch_calculation_version") @db.VarChar(20)
  raw_milk_dispatch_note_number        String?           @map("raw_milk_dispatch_note_number") @db.VarChar(100)
  correction_count                     Int               @default(0) @map("correction_count")
  manager_correction_count             Int               @default(0) @map("manager_correction_count")
  last_corrected_by_user_id            BigInt?           @map("last_corrected_by_user_id")
  last_corrected_at                    DateTime?         @map("last_corrected_at") @db.Timestamp(6)

  // Phase 2: Stage 3 dispatch test mode + approval request (plan §3 Stage 3, §8-2, §14)
  test_mode                       String?   @map("test_mode") @db.VarChar(20) // COMPOSITE | PORTION_WISE
  approval_status                 String    @default("NONE") @map("approval_status") @db.VarChar(30) // NONE | PENDING | APPROVED | RETURNED
  approval_request_remarks        String?   @map("approval_request_remarks") @db.Text
  approval_requested_by           BigInt?   @map("approval_requested_by")
  approval_requested_as_role      String?   @map("approval_requested_as_role") @db.VarChar(64)
  approval_requested_is_delegated Boolean   @default(false) @map("approval_requested_is_delegated")
  approval_requested_at           DateTime? @map("approval_requested_at") @db.Timestamp(6)
  approver_role                   String?   @map("approver_role") @db.VarChar(64) // ZMCC_MANAGER | CONTRACTOR_MANAGER
  approval_decided_by             BigInt?   @map("approval_decided_by")
  approval_decided_as_role        String?   @map("approval_decided_as_role") @db.VarChar(64)
  approval_decided_is_delegated   Boolean   @default(false) @map("approval_decided_is_delegated")
  approval_decided_at             DateTime? @map("approval_decided_at") @db.Timestamp(6)
  approval_decision_remarks       String?   @map("approval_decision_remarks") @db.Text
  rule_violation_summary          String?   @map("rule_violation_summary") @db.VarChar(255)
  // Phase 2: business date provenance (plan §3 Stage 4, §8)
  business_date_source            String?   @map("business_date_source") @db.VarChar(30) // FIRST_WEIGHT | LAST_QA_REJECTION
  business_date_set_at            DateTime? @map("business_date_set_at") @db.Timestamp(6)
  // Phase 4c: Stage 3 dispatch decision (person vs system) + optimistic version for the approver queue
  dispatch_person_decision        String?   @map("dispatch_person_decision") @db.VarChar(10) // ACCEPT | REJECT
  dispatch_decision_remarks       String?   @map("dispatch_decision_remarks") @db.Text
  dispatch_system_outcome         String?   @map("dispatch_system_outcome") @db.VarChar(10) // PASS | FAIL
  dispatch_exception_reasons      Json?     @map("dispatch_exception_reasons") @db.JsonB
  dispatch_decision_details       Json?     @map("dispatch_decision_details") @db.JsonB
  dispatch_lab_report_capture_id  String?   @map("dispatch_lab_report_capture_id") @db.VarChar(64)
  dispatch_policy_version         Int?      @map("dispatch_policy_version")
  dispatch_submitted_by           BigInt?   @map("dispatch_submitted_by")
  dispatch_submitted_as_role      String?   @map("dispatch_submitted_as_role") @db.VarChar(64)
  dispatch_submitted_is_delegated Boolean   @default(false) @map("dispatch_submitted_is_delegated")
  dispatch_submitted_at           DateTime? @map("dispatch_submitted_at") @db.Timestamp(6)
  dispatch_version                Int       @default(0) @map("dispatch_version")

  // Relations
  procurement_source       ProcurementSource?              @relation("VisitSource", fields: [procurement_source_id], references: [id], onDelete: SetNull)
  creator                  User?                           @relation("CreatedBy", fields: [created_by], references: [id])
  last_corrected_by        User?                           @relation("VehicleVisitLastCorrectedBy", fields: [last_corrected_by_user_id], references: [id], onDelete: SetNull)
  portions                 VisitPortion[]
  gate_log                 GateLog?
  weight_ticket            WeightTicket?
  dispatch_lab_results     DispatchLabResult[]
  plant_lab_results        PlantLabResult[]
  qa_session               QATestingSession?
  inventory_transactions   SiloInventoryTransaction[]
  qa_warnings              QAWarning[]
  test_assignments         LabTestAssignment[]
  quantity_policy_snapshot DispatchQuantityPolicySnapshot?
  dual_reconciliation      PlantFinalDualReconciliation?   @relation("VisitDualReconciliation")
  approval_requester       User?                           @relation("VehicleVisitApprovalRequestedBy", fields: [approval_requested_by], references: [id], onDelete: SetNull)
  approval_decider         User?                           @relation("VehicleVisitApprovalDecidedBy", fields: [approval_decided_by], references: [id], onDelete: SetNull)

  @@index([current_status, created_at])
  @@index([created_at])
  @@index([procurement_source_id, created_at])
  @@index([raw_milk_dispatch_note_number])
  @@index([approval_status, approver_role])
  @@map("vehicle_visit")
}

model VisitPortion {
  id                         BigInt            @id @default(autoincrement())
  visit_id                   BigInt            @map("visit_id")
  portion_number             Int               @map("portion_number") @db.SmallInt
  current_status             String            @default("DISPATCHED") @map("current_status") @db.VarChar(255)
  dispatch_quantity_value    Decimal?          @map("dispatch_quantity_value") @db.Decimal(10, 2)
  dispatch_quantity_unit     QuantityUnit?     @map("dispatch_quantity_unit")
  dispatch_quantity_basis    MeasurementBasis? @map("dispatch_quantity_basis")
  plant_decision             String?           @map("plant_decision") @db.VarChar(255)
  plant_rejection_reason     String?           @map("plant_rejection_reason") @db.Text
  plant_decided_by           BigInt?           @map("plant_decided_by")
  plant_decided_at           DateTime?         @map("plant_decided_at") @db.Timestamp(6)
  creation_client_event_id   String?           @unique @map("creation_client_event_id") @db.VarChar(255)
  completion_client_event_id String?           @unique @map("completion_client_event_id") @db.VarChar(255)

  // QA Manager Review Workflow (Stage 6G-G)
  system_quality_outcome              String?   @map("system_quality_outcome") @db.VarChar(50)
  manager_review_status               String    @default("NONE") @map("manager_review_status") @db.VarChar(50)
  manager_requested_decision          String?   @map("manager_requested_decision") @db.VarChar(50)
  manager_review_requested_by_user_id BigInt?   @map("manager_review_requested_by_user_id")
  manager_review_requested_at         DateTime? @map("manager_review_requested_at") @db.Timestamp(6)
  manager_reviewed_by_user_id         BigInt?   @map("manager_reviewed_by_user_id")
  manager_reviewed_at                 DateTime? @map("manager_reviewed_at") @db.Timestamp(6)
  manager_review_reason               String?   @map("manager_review_reason") @db.Text

  // Exception Classification & Decision Tracking (Stage 6G-G)
  original_plant_decision  String?   @map("original_plant_decision") @db.VarChar(255)
  corrected_plant_decision String?   @map("corrected_plant_decision") @db.VarChar(255)
  plant_correction_reason  String?   @map("plant_correction_reason") @db.Text
  plant_corrected_by       BigInt?   @map("plant_corrected_by")
  plant_corrected_at       DateTime? @map("plant_corrected_at") @db.Timestamp(6)
  correction_count         Int       @default(0) @map("correction_count")
  manager_correction_count Int       @default(0) @map("manager_correction_count")

  // Phase 2: Stage 3 seal + Stage 4 seal check at plant (plan §3 Stage 3/4)
  seal_number                   String?   @map("seal_number") @db.VarChar(50)
  plant_seal_number_entered     String?   @map("plant_seal_number_entered") @db.VarChar(50)
  seal_match                    Boolean?  @map("seal_match")
  seal_checked_by               BigInt?   @map("seal_checked_by")
  seal_checked_as_role          String?   @map("seal_checked_as_role") @db.VarChar(64)
  seal_checked_is_delegated     Boolean   @default(false) @map("seal_checked_is_delegated")
  seal_checked_at               DateTime? @map("seal_checked_at") @db.Timestamp(6)
  // Phase 2: decision-rule extras (plan §14); existing plant_decision / system_quality_outcome / manager_review_* reused
  exception_reasons             Json?     @map("exception_reasons") @db.JsonB // ["SEAL_MISMATCH","RULE_FAIL:FAT",...]
  // Phase 4d: MPD disposition remarks
  mpd_disposition_remarks       String?   @map("mpd_disposition_remarks") @db.Text
  mpd_disposition_by            BigInt?   @map("mpd_disposition_by")
  mpd_disposition_at            DateTime? @map("mpd_disposition_at") @db.Timestamp(6)
  mpd_disposition_user          User?     @relation("VisitPortionMpdDispositionBy", fields: [mpd_disposition_by], references: [id], onDelete: SetNull)
  plant_decided_as_role         String?   @map("plant_decided_as_role") @db.VarChar(64)
  plant_decided_is_delegated    Boolean   @default(false) @map("plant_decided_is_delegated")
  manager_reviewed_as_role      String?   @map("manager_reviewed_as_role") @db.VarChar(64)
  manager_reviewed_is_delegated Boolean   @default(false) @map("manager_reviewed_is_delegated")
  created_at                    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at                    DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Weighing fields for portion-wise reception
  first_weight_kg          Decimal?  @map("first_weight_kg") @db.Decimal(12, 3)
  first_weight_at          DateTime? @map("first_weight_at") @db.Timestamp(6)
  first_weight_by_user_id  BigInt?   @map("first_weight_by_user_id")
  second_weight_kg         Decimal?  @map("second_weight_kg") @db.Decimal(12, 3)
  second_weight_at         DateTime? @map("second_weight_at") @db.Timestamp(6)
  second_weight_by_user_id BigInt?   @map("second_weight_by_user_id")
  net_weight_kg            Decimal?  @map("net_weight_kg") @db.Decimal(12, 3)
  first_weigher            User?     @relation("VisitPortionFirstWeighedBy", fields: [first_weight_by_user_id], references: [id], onDelete: SetNull)
  second_weigher           User?     @relation("VisitPortionSecondWeighedBy", fields: [second_weight_by_user_id], references: [id], onDelete: SetNull)

  // Relations
  visit                  VehicleVisit               @relation(fields: [visit_id], references: [id], onDelete: Cascade)
  decided_by             User?                      @relation("PlantDecidedBy", fields: [plant_decided_by], references: [id])
  plant_corrector        User?                      @relation("PlantCorrectedBy", fields: [plant_corrected_by], references: [id])
  manager_reviewer       User?                      @relation("PlantPortionReviewedBy", fields: [manager_reviewed_by_user_id], references: [id])
  manager_requester      User?                      @relation("PlantPortionReviewRequestedBy", fields: [manager_review_requested_by_user_id], references: [id])
  dispatch_info          DispatchInfo?
  dispatch_lab_results   DispatchLabResult[]
  plant_lab_results      PlantLabResult[]
  unloading_log          UnloadingLog?
  inventory_transactions SiloInventoryTransaction[]
  qa_warnings            QAWarning[]
  seal_checker           User?                      @relation("PortionSealCheckedBy", fields: [seal_checked_by], references: [id], onDelete: SetNull)
  weight_tickets         WeightTicket[]             @relation("WeightTicketPortion")

  @@unique([visit_id, portion_number])
  @@unique([visit_id, seal_number])
  @@index([plant_decision])
  @@index([manager_review_status])
  @@index([seal_number])
  @@map("visit_portion")
}

model DispatchInfo {
  id                       BigInt    @id @default(autoincrement())
  portion_id               BigInt    @unique @map("portion_id")
  dispatch_number          String?   @map("dispatch_number") @db.VarChar(255)
  dispatch_timestamp       DateTime? @map("dispatch_timestamp") @db.Timestamp(6)
  dispatch_testing_mode    String?   @default("FULL") @map("dispatch_testing_mode") @db.VarChar(50)
  dispatch_testing_reason  String?   @map("dispatch_testing_reason") @db.Text
  dispatch_testing_remarks String?   @map("dispatch_testing_remarks") @db.Text
  recorded_by              BigInt?   @map("recorded_by")
  recorded_as_role         String?   @map("recorded_as_role") @db.VarChar(64)
  recorded_is_delegated    Boolean   @default(false) @map("recorded_is_delegated")
  created_at               DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at               DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  portion  VisitPortion @relation(fields: [portion_id], references: [id], onDelete: Cascade)
  recorder User?        @relation("RecordedBy", fields: [recorded_by], references: [id])

  @@map("dispatch_info")
}

model GateLog {
  id                 BigInt    @id @default(autoincrement())
  visit_id           BigInt    @unique @map("visit_id")
  entry_timestamp    DateTime? @map("entry_timestamp") @db.Timestamp(6)
  exit_timestamp     DateTime? @map("exit_timestamp") @db.Timestamp(6)
  entry_guard_id     BigInt?   @map("entry_guard_id")
