model ZmccRoute {
  id          BigInt   @id @default(autoincrement())
  route_code  String   @unique @map("route_code") @db.VarChar(50)
  name        String   @map("name") @db.VarChar(150)
  origin      String   @map("origin") @db.VarChar(150)
  destination String   @map("destination") @db.VarChar(150)
  zmcc_id     BigInt   @map("zmcc_id")
  is_active   Boolean  @default(true) @map("is_active")
  created_by  BigInt   @map("created_by")
  updated_by  BigInt?  @map("updated_by")
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at  DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  zmcc         ProcurementSource @relation("ZmccRoutes", fields: [zmcc_id], references: [id], onDelete: Restrict)
  creator      User              @relation("ZmccRouteCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)
  updater      User?             @relation("ZmccRouteUpdatedBy", fields: [updated_by], references: [id], onDelete: Restrict)
  areas        ZmccArea[]
  mot_journeys MotJourney[]

  @@unique([zmcc_id, name])
  @@unique([id, zmcc_id])
  @@index([zmcc_id])
  @@map("zmcc_route")
}

model ZmccArea {
  id         BigInt   @id @default(autoincrement())
  area_code  String   @unique @map("area_code") @db.VarChar(50)
  name       String   @map("name") @db.VarChar(150)
  route_id   BigInt   @map("route_id")
