  updated_by BigInt?  @map("updated_by")
  created_at DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  route   ZmccRoute  @relation(fields: [route_id, zmcc_id], references: [id, zmcc_id], onDelete: Restrict)
  creator User       @relation("ZmccAreaCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)
  updater User?      @relation("ZmccAreaUpdatedBy", fields: [updated_by], references: [id], onDelete: Restrict)
  shops   ZmccShop[]

  @@unique([route_id, name])
  @@unique([id, route_id, zmcc_id])
  @@index([route_id])
  @@index([zmcc_id])
  @@map("zmcc_area")
}

