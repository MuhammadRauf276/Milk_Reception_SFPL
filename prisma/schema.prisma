model MotJourney {
  id                      BigInt    @id @default(autoincrement())
  journey_number          String    @unique @map("journey_number") @db.VarChar(50)
  operational_date        DateTime  @map("operational_date") @db.Date
  zmcc_id                 BigInt    @map("zmcc_id")
  route_id                BigInt    @map("route_id")
  mot_profile_id          BigInt    @map("mot_profile_id")
  mot_vehicle_id          BigInt    @map("mot_vehicle_id")
  status                  String    @default("COLLECTING") @map("status") @db.VarChar(50)
  assigned_by             BigInt    @map("assigned_by")
  assigned_at             DateTime  @map("assigned_at") @db.Timestamp(6)
  assignment_latitude     Decimal   @map("assignment_latitude") @db.Decimal(10, 7)
  assignment_longitude    Decimal   @map("assignment_longitude") @db.Decimal(10, 7)
  assignment_gps_accuracy Decimal?  @map("assignment_gps_accuracy") @db.Decimal(8, 2)
  started_at              DateTime  @map("started_at") @db.Timestamp(6)
  start_latitude          Decimal   @map("start_latitude") @db.Decimal(10, 7)
  start_longitude         Decimal   @map("start_longitude") @db.Decimal(10, 7)
  first_mot_gps_at        DateTime? @map("first_mot_gps_at") @db.Timestamp(6)
  first_mot_latitude      Decimal?  @map("first_mot_latitude") @db.Decimal(10, 7)
  first_mot_longitude     Decimal?  @map("first_mot_longitude") @db.Decimal(10, 7)
  first_mot_gps_accuracy  Decimal?  @map("first_mot_gps_accuracy") @db.Decimal(8, 2)
  idempotency_key         String    @unique @map("idempotency_key") @db.VarChar(255)
  ended_at                DateTime? @map("ended_at") @db.Timestamp(6)
  cancelled_by            BigInt?   @map("cancelled_by")
  cancelled_at            DateTime? @map("cancelled_at") @db.Timestamp(6)
  cancellation_reason     String?   @map("cancellation_reason") @db.Text
  created_at              DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at              DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  zmcc        ProcurementSource    @relation("ZmccJourneys", fields: [zmcc_id], references: [id], onDelete: Restrict)
  route       ZmccRoute            @relation(fields: [route_id, zmcc_id], references: [id, zmcc_id], onDelete: Restrict)
  mot_profile MotProfile           @relation(fields: [mot_profile_id, zmcc_id], references: [id, zmcc_id], onDelete: Restrict)
  mot_vehicle MotVehicle           @relation(fields: [mot_vehicle_id, zmcc_id], references: [id, zmcc_id], onDelete: Restrict)
  assigner    User                 @relation("MotJourneyAssignedBy", fields: [assigned_by], references: [id], onDelete: Restrict)
  canceller   User?                @relation("MotJourneyCancelledBy", fields: [cancelled_by], references: [id], onDelete: Restrict)
  stops       MotJourneyStop[]
  locations   MotJourneyLocation[]

  @@unique([id, zmcc_id])
  @@index([zmcc_id])
  @@index([route_id])
  @@index([mot_profile_id])
  @@index([mot_vehicle_id])
  @@index([status])
  @@index([operational_date])
  @@map("mot_journey")
}

model MotJourneyStop {
  id               BigInt    @id @default(autoincrement())
  journey_id       BigInt    @map("journey_id")
  shop_id          BigInt    @map("shop_id")
  planned_sequence Int       @map("planned_sequence")
  status           String    @default("PENDING") @map("status") @db.VarChar(50)
  arrived_at       DateTime? @map("arrived_at") @db.Timestamp(6)
  completed_at     DateTime? @map("completed_at") @db.Timestamp(6)
  skipped_at       DateTime? @map("skipped_at") @db.Timestamp(6)
  skip_reason      String?   @map("skip_reason") @db.Text
  created_at       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  journey MotJourney @relation(fields: [journey_id], references: [id], onDelete: Restrict)
  shop    ZmccShop   @relation(fields: [shop_id], references: [id], onDelete: Restrict)

  @@unique([journey_id, shop_id])
  @@unique([journey_id, planned_sequence])
  @@index([journey_id])
  @@index([shop_id])
  @@map("mot_journey_stop")
}

model MotJourneyLocation {
  id                  BigInt   @id @default(autoincrement())
  journey_id          BigInt   @map("journey_id")
  recorded_by_user_id BigInt?  @map("recorded_by_user_id")
  source_type         String   @map("source_type") @db.VarChar(50)
  latitude            Decimal  @map("latitude") @db.Decimal(10, 7)
  longitude           Decimal  @map("longitude") @db.Decimal(10, 7)
  gps_accuracy        Decimal? @map("gps_accuracy") @db.Decimal(8, 2)
  device_recorded_at  DateTime @map("device_recorded_at") @db.Timestamp(6)
  server_received_at  DateTime @default(now()) @map("server_received_at") @db.Timestamp(6)
  idempotency_key     String   @unique @map("idempotency_key") @db.VarChar(255)
  created_at          DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  journey     MotJourney @relation(fields: [journey_id], references: [id], onDelete: Restrict)
  recorded_by User?      @relation("MotJourneyLocationRecordedBy", fields: [recorded_by_user_id], references: [id], onDelete: Restrict)

  @@index([journey_id])
  @@index([device_recorded_at])
  @@map("mot_journey_location")
}
