model ZmccTank {
  id                 BigInt   @id @default(autoincrement())
  zmcc_id            BigInt   @map("zmcc_id")
  tank_code          String   @map("tank_code") @db.VarChar(50)
  tank_name          String   @map("tank_name") @db.VarChar(150)
  capacity_liters    Decimal  @map("capacity_liters") @db.Decimal(12, 2)
  is_active          Boolean  @default(true) @map("is_active")
  created_by_user_id BigInt   @map("created_by_user_id")
  updated_by_user_id BigInt?  @map("updated_by_user_id")
  created_at         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at         DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  zmcc         ProcurementSource              @relation("ZmccTanks", fields: [zmcc_id], references: [id], onDelete: Restrict)
  creator      User                           @relation("ZmccTankCreatedBy", fields: [created_by_user_id], references: [id], onDelete: Restrict)
  updater      User?                          @relation("ZmccTankUpdatedBy", fields: [updated_by_user_id], references: [id], onDelete: Restrict)
  receipts     ZmccTankReceipt[]
  transactions ZmccTankInventoryTransaction[]
  portions     ZmccLabPortion[]               @relation("ZmccTankPortions")

  version Int @default(1) @map("version")

  @@unique([zmcc_id, tank_code])
  @@index([zmcc_id, is_active])
  @@map("zmcc_tank")
}

model ZmccTankReceipt {
  id                        BigInt       @id @default(autoincrement())
  lab_session_id            BigInt       @unique @map("lab_session_id")
  zmcc_id                   BigInt       @map("zmcc_id")
  tank_id                   BigInt       @map("tank_id")
  arrival_type              String       @map("arrival_type") @db.VarChar(20) // MOT or HC
  quantity_value            Decimal      @map("quantity_value") @db.Decimal(12, 2)
  quantity_unit             QuantityUnit @map("quantity_unit")
  density                   Decimal      @map("density") @db.Decimal(6, 4)
  gross_liters              Decimal      @map("gross_liters") @db.Decimal(12, 2)
  lr                        Decimal      @map("lr") @db.Decimal(6, 2)
  fat                       Decimal      @map("fat") @db.Decimal(5, 2)
  snf                       Decimal      @map("snf") @db.Decimal(6, 2)
  ts                        Decimal      @map("ts") @db.Decimal(6, 2)
  at_13ts_liters            Decimal      @map("at_13ts_liters") @db.Decimal(12, 2)
  calculation_version       String       @map("calculation_version") @db.VarChar(20)
  received_at               DateTime     @default(now()) @map("received_at") @db.Timestamp(6)
  received_by_user_id       BigInt       @map("received_by_user_id")
  correction_count          Int          @default(0) @map("correction_count")
  manager_correction_count  Int          @default(0) @map("manager_correction_count")
  last_corrected_by_user_id BigInt?      @map("last_corrected_by_user_id")
  last_corrected_at         DateTime?    @map("last_corrected_at") @db.Timestamp(6)
  created_at                DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at                DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  milk_source_id            BigInt?      @map("milk_source_id")
  milk_source_code_snapshot String?      @map("milk_source_code_snapshot") @db.VarChar(50)
  milk_source_name_snapshot String?      @map("milk_source_name_snapshot") @db.VarChar(150)
  portion_id                BigInt?      @unique @map("portion_id") // Phase 2; lab_session_id @unique -> @@unique([portion_id]) deferred

  // Relations
  lab_session        ZmccLabSession                 @relation("ZmccLabSessionReceipt", fields: [lab_session_id], references: [id], onDelete: Restrict)
  zmcc               ProcurementSource              @relation("ZmccTankReceipts", fields: [zmcc_id], references: [id], onDelete: Restrict)
  tank               ZmccTank                       @relation(fields: [tank_id], references: [id], onDelete: Restrict)
  receiver           User                           @relation("ZmccTankReceivedBy", fields: [received_by_user_id], references: [id], onDelete: Restrict)
  last_corrector     User?                          @relation("ZmccTankReceiptLastCorrectedBy", fields: [last_corrected_by_user_id], references: [id], onDelete: Restrict)
  transactions       ZmccTankInventoryTransaction[]
  local_supplier_rmr LocalSupplierRmrIssuance?      @relation("LocalSupplierRmrTankReceipt")
  milk_source        ZmccMilkSource?                @relation(fields: [milk_source_id], references: [id], onDelete: SetNull)
  portion            ZmccLabPortion?                @relation("ZmccPortionReceipts", fields: [portion_id], references: [id], onDelete: Restrict)

  @@index([zmcc_id, received_at])
  @@index([tank_id])
  @@index([portion_id])
  @@index([milk_source_id])
  @@map("zmcc_tank_receipt")
}

model ZmccTankInventoryTransaction {
  id                    BigInt                  @id @default(autoincrement())
  tank_id               BigInt                  @map("tank_id")
  zmcc_id               BigInt                  @map("zmcc_id")
  transaction_type      ZmccTankTransactionType @map("transaction_type")
  quantity_liters       Decimal                 @map("quantity_liters") @db.Decimal(12, 2)
  at_13ts_liters        Decimal?                @map("at_13ts_liters") @db.Decimal(12, 2)
  tank_receipt_id       BigInt?                 @map("tank_receipt_id")
  dispatch_id           BigInt?                 @map("dispatch_id")
  reference_type        String                  @map("reference_type") @db.VarChar(50)
  reference_id          String                  @map("reference_id") @db.VarChar(100)
  idempotency_key       String                  @unique @map("idempotency_key") @db.VarChar(150)
  operational_timestamp DateTime                @default(now()) @map("operational_timestamp") @db.Timestamp(6)
  performed_by_user_id  BigInt                  @map("performed_by_user_id")
  notes                 String?                 @map("notes") @db.VarChar(255)
  created_at            DateTime                @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  tank      ZmccTank          @relation(fields: [tank_id], references: [id], onDelete: Restrict)
  zmcc      ProcurementSource @relation("ZmccTankTransactions", fields: [zmcc_id], references: [id], onDelete: Restrict)
  receipt   ZmccTankReceipt?  @relation(fields: [tank_receipt_id], references: [id], onDelete: Restrict)
  performer User              @relation("ZmccTankTransactionPerformedBy", fields: [performed_by_user_id], references: [id], onDelete: Restrict)

  @@index([tank_id, operational_timestamp])
  @@index([zmcc_id, operational_timestamp])
  @@map("zmcc_tank_inventory_transaction")
}

model MilkSourceZmccVisibility {
  id             BigInt   @id @default(autoincrement())
  milk_source_id BigInt   @map("milk_source_id")
  zmcc_id        BigInt   @map("zmcc_id")
  is_active      Boolean  @default(true) @map("is_active")
  created_at     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  milk_source ZmccMilkSource    @relation(fields: [milk_source_id], references: [id], onDelete: Cascade)
  zmcc        ProcurementSource @relation("ZmccMilkSourceVisibilities", fields: [zmcc_id], references: [id], onDelete: Restrict)

  @@unique([milk_source_id, zmcc_id])
  @@index([zmcc_id, is_active])
  @@map("milk_source_zmcc_visibility")
}

// Global setting (single active row): may MDO / PHE Operator type the net quantity instead of weighing
model ZmccWeighingPolicy {
  id                   BigInt   @id @default(autoincrement())
  manual_entry_enabled Boolean  @default(false) @map("manual_entry_enabled")
  allowed_units        String   @default("BOTH") @map("allowed_units") @db.VarChar(10) // KG | LITER | BOTH
  version              Int      @default(1) @map("version")
  updated_by           BigInt?  @map("updated_by")
  created_at           DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at           DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("zmcc_weighing_policy")
}

// Phase 3: Server-side operation idempotency store for transactional operations
model OperationIdempotencyRecord {
  id               BigInt   @id @default(autoincrement())
  key              String   @unique @map("key") @db.VarChar(255)
  operation_type   String   @map("operation_type") @db.VarChar(64)
  entity_type      String   @map("entity_type") @db.VarChar(64)
  entity_id        BigInt   @map("entity_id")
  payload_hash     String?  @map("payload_hash") @db.VarChar(64)
  request_payload  Json?    @map("request_payload") @db.JsonB
  response_payload Json     @map("response_payload") @db.JsonB
  status_code      Int      @default(200) @map("status_code")
  created_at       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([operation_type, entity_id])
  @@map("operation_idempotency_record")
}
