  // Phase 2: Area (MOT) loss/gain stored at journey close, accepted portions only (plan §3 S2)
  area_received_net_kg             Decimal?  @map("area_received_net_kg") @db.Decimal(12, 3)
  area_received_liters             Decimal?  @map("area_received_liters") @db.Decimal(12, 2)
  area_received_at_13ts_liters     Decimal?  @map("area_received_at_13ts_liters") @db.Decimal(12, 2)
  area_mot_declared_liters         Decimal?  @map("area_mot_declared_liters") @db.Decimal(12, 2)
  area_mot_declared_at_13ts_liters Decimal?  @map("area_mot_declared_at_13ts_liters") @db.Decimal(12, 2)
  area_loss_gain_liters            Decimal?  @map("area_loss_gain_liters") @db.Decimal(12, 2) // signed: received - declared; negative = loss
  area_loss_gain_at_13ts_liters    Decimal?  @map("area_loss_gain_at_13ts_liters") @db.Decimal(12, 2)
  area_loss_gain_pct               Decimal?  @map("area_loss_gain_pct") @db.Decimal(7, 4) // signed, % of declared
  area_computed_at                 DateTime? @map("area_computed_at") @db.Timestamp(6)

  // Relations
  zmcc        ProcurementSource    @relation("ZmccJourneys", fields: [zmcc_id], references: [id], onDelete: Restrict)
  route       ZmccRoute            @relation(fields: [route_id, zmcc_id], references: [id, zmcc_id], onDelete: Restrict)
  mot_profile MotProfile           @relation(fields: [mot_profile_id, zmcc_id], references: [id, zmcc_id], onDelete: Restrict)
  mot_vehicle MotVehicle           @relation(fields: [mot_vehicle_id, zmcc_id], references: [id, zmcc_id], onDelete: Restrict)
  assigner    User                 @relation("MotJourneyAssignedBy", fields: [assigned_by], references: [id], onDelete: Restrict)
  canceller   User?                @relation("MotJourneyCancelledBy", fields: [cancelled_by], references: [id], onDelete: Restrict)
  stops       MotJourneyStop[]
  locations   MotJourneyLocation[]
  collections MotShopCollection[]
  mot_arrival ZmccMotArrival?
  summary     MotJourneySummary?

  version Int @default(1) @map("version")

  @@unique([id, zmcc_id])
  @@index([zmcc_id])
  @@index([route_id])
  @@index([mot_profile_id])
  @@index([mot_vehicle_id])
  @@index([status])
  @@index([operational_date])
  @@map("mot_journey")
}

