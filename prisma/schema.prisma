  sha256              String   @map("sha256") @db.Char(64)
  file_path           String   @map("file_path") @db.VarChar(512)
  mime                String   @default("image/jpeg") @map("mime") @db.VarChar(50)
  width               Int      @map("width")
  height              Int      @map("height")
  bytes               Int      @map("bytes")
  testing_point       String   @map("testing_point") @db.VarChar(50)
  entity_type         String   @map("entity_type") @db.VarChar(50) // MOT_SHOP_COLLECTION | ZMCC_LAB_PORTION | DISPATCH_PORTION | PLANT_PORTION_TEST | GATE_LOG ...
  entity_id           BigInt   @map("entity_id")
  lab_test_id         BigInt?  @map("lab_test_id")
  portion_number      Int?     @map("portion_number")
  photo_kind          String   @default("TEST_RESULT") @map("photo_kind") @db.VarChar(30) // TEST_RESULT | LAB_REPORT | TANKER_WASH | OTHER
  captured_by         BigInt   @map("captured_by")
  performed_as_role   String?  @map("performed_as_role") @db.VarChar(64)
  is_delegated        Boolean  @default(false) @map("is_delegated")
  device_id           BigInt?  @map("device_id")
  device_captured_at  DateTime @map("device_captured_at") @db.Timestamp(6)
  server_received_at  DateTime @default(now()) @map("server_received_at") @db.Timestamp(6)
