model ZmccShop {
  id                   BigInt   @id @default(autoincrement())
  shop_code            String   @unique @map("shop_code") @db.VarChar(50)
  shop_name            String   @map("shop_name") @db.VarChar(150)
  owner_name           String   @map("owner_name") @db.VarChar(150)
  phone_number         String   @map("phone_number") @db.VarChar(30)
  cnic                 String   @map("cnic") @db.VarChar(30)
  area_id              BigInt   @map("area_id")
  route_id             BigInt   @map("route_id")
  zmcc_id              BigInt   @map("zmcc_id")
  milk_source_id       BigInt   @map("milk_source_id")
  chiller_ownership_id BigInt   @map("chiller_ownership_id")
  latitude             Decimal? @map("latitude") @db.Decimal(10, 7)
  longitude            Decimal? @map("longitude") @db.Decimal(10, 7)
  is_active            Boolean  @default(true) @map("is_active")
  created_by           BigInt   @map("created_by")
  updated_by           BigInt?  @map("updated_by")
  created_at           DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at           DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  area              ZmccArea         @relation(fields: [area_id, route_id, zmcc_id], references: [id, route_id, zmcc_id], onDelete: Restrict)
  milk_source       ZmccMilkSource   @relation(fields: [milk_source_id, zmcc_id], references: [id, zmcc_id], onDelete: Restrict)
  chiller_ownership ChillerOwnership @relation(fields: [chiller_ownership_id], references: [id], onDelete: Restrict)
  creator           User             @relation("ZmccShopCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)
  updater           User?            @relation("ZmccShopUpdatedBy", fields: [updated_by], references: [id], onDelete: Restrict)
  journey_stops     MotJourneyStop[]

  @@unique([area_id, shop_name])
  @@index([area_id])
  @@index([route_id])
  @@index([zmcc_id])
  @@index([milk_source_id])
  @@index([chiller_ownership_id])
  @@map("zmcc_shop")
}

