model ZmccLabSession {
  id                               BigInt        @id @default(autoincrement())
  zmcc_id                          BigInt        @map("zmcc_id")
  arrival_type                     String        @map("arrival_type") @db.VarChar(20) // MOT or HC
  mot_arrival_id                   BigInt?       @unique @map("mot_arrival_id")
  local_supplier_arrival_id        BigInt?       @unique @map("local_supplier_arrival_id")
  status                           String        @default("IN_PROGRESS") @map("status") @db.VarChar(50) // IN_PROGRESS or COMPLETED
  started_by_user_id               BigInt        @map("started_by_user_id")
  started_at                       DateTime      @default(now()) @map("started_at") @db.Timestamp(6)
  completed_by_user_id             BigInt?       @map("completed_by_user_id")
  completed_at                     DateTime?     @map("completed_at") @db.Timestamp(6)
  decision                         String?       @map("decision") @db.VarChar(50) // ACCEPTED or REJECTED
  attendant_recommendation         String?       @map("attendant_recommendation") @db.VarChar(50)
  attendant_recommended_by_user_id BigInt?       @map("attendant_recommended_by_user_id")
  attendant_recommended_at         DateTime?     @map("attendant_recommended_at") @db.Timestamp(6)
  final_decision                   String?       @map("final_decision") @db.VarChar(50)
  final_decided_by_user_id         BigInt?       @map("final_decided_by_user_id")
  final_decided_at                 DateTime?     @map("final_decided_at") @db.Timestamp(6)
  final_decision_reason            String?       @map("final_decision_reason") @db.Text
  rejection_reason                 String?       @map("rejection_reason") @db.Text
  remarks                          String?       @map("remarks") @db.Text
  completion_client_event_id       String?       @unique @map("completion_client_event_id") @db.VarChar(255)
  quantity_value                   Decimal?      @map("quantity_value") @db.Decimal(12, 2)
  quantity_unit                    QuantityUnit? @map("quantity_unit")
  density                          Decimal?      @map("density") @db.Decimal(6, 4)
  gross_liters                     Decimal?      @map("gross_liters") @db.Decimal(12, 2)
  snf                              Decimal?      @map("snf") @db.Decimal(6, 2)
  ts                               Decimal?      @map("ts") @db.Decimal(6, 2)
  at_13ts_liters                   Decimal?      @map("at_13ts_liters") @db.Decimal(12, 2)
  calculation_version              String?       @map("calculation_version") @db.VarChar(20)
  correction_count                 Int           @default(0) @map("correction_count")
  manager_correction_count         Int           @default(0) @map("manager_correction_count")
  last_corrected_by_user_id        BigInt?       @map("last_corrected_by_user_id")
  last_corrected_at                DateTime?     @map("last_corrected_at") @db.Timestamp(6)

  // QA Manager Review Workflow (Stage 6G-G)
  system_quality_outcome              String?   @map("system_quality_outcome") @db.VarChar(50)
  manager_review_status               String    @default("NONE") @map("manager_review_status") @db.VarChar(50)
  manager_requested_decision          String?   @map("manager_requested_decision") @db.VarChar(50)
  manager_review_requested_by_user_id BigInt?   @map("manager_review_requested_by_user_id")
  manager_review_requested_at         DateTime? @map("manager_review_requested_at") @db.Timestamp(6)
  manager_reviewed_by_user_id         BigInt?   @map("manager_reviewed_by_user_id")
  manager_reviewed_at                 DateTime? @map("manager_reviewed_at") @db.Timestamp(6)
  manager_review_reason               String?   @map("manager_review_reason") @db.Text

  // Exception Classification & Decision Tracking (Stage 6G-G)
  original_decision  String? @map("original_decision") @db.VarChar(50)
  corrected_decision String? @map("corrected_decision") @db.VarChar(50)
  correction_reason  String? @map("correction_reason") @db.Text

  // Phase 2: role attribution (plan §14)
  started_as_role               String?   @map("started_as_role") @db.VarChar(64)
  started_is_delegated          Boolean   @default(false) @map("started_is_delegated")
  completed_as_role             String?   @map("completed_as_role") @db.VarChar(64)
  completed_is_delegated        Boolean   @default(false) @map("completed_is_delegated")
  final_decided_as_role         String?   @map("final_decided_as_role") @db.VarChar(64)
  final_decided_is_delegated    Boolean   @default(false) @map("final_decided_is_delegated")
  manager_reviewed_as_role      String?   @map("manager_reviewed_as_role") @db.VarChar(64)
  manager_reviewed_is_delegated Boolean   @default(false) @map("manager_reviewed_is_delegated")
  // Phase 2: portion-wise testing (plan §3 Stage 2)
  test_mode                     String    @default("COMPOSITE") @map("test_mode") @db.VarChar(20) // COMPOSITE | PORTION_WISE
  journey_closed_at             DateTime? @map("journey_closed_at") @db.Timestamp(6)
  closed_reason                 String?   @map("closed_reason") @db.VarChar(50) // ALL_PORTIONS_REJECTED | ALL_PORTIONS_WEIGHED | CLOSED_WITHOUT_UNLOADING
  // Unload to tank (one action per vehicle) and exit outcome
  unloaded_at                   DateTime? @map("unloaded_at") @db.Timestamp(6)
  unloaded_by_user_id           BigInt?   @map("unloaded_by_user_id")
  exit_outcome                  String?   @map("exit_outcome") @db.VarChar(30) // RECEIVED | REJECTED | PARTLY_RECEIVED | ACCEPTED_NOT_RECEIVED
  exit_reason_code              String?   @map("exit_reason_code") @db.VarChar(40)
  exit_remarks                  String?   @map("exit_remarks") @db.Text
  close_requested_by_user_id    BigInt?   @map("close_requested_by_user_id")
  close_requested_at            DateTime? @map("close_requested_at") @db.Timestamp(6)
  close_approved_by_user_id     BigInt?   @map("close_approved_by_user_id")
  close_approved_at             DateTime? @map("close_approved_at") @db.Timestamp(6)
  created_at                    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at                    DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  zmcc                   ProcurementSource         @relation("ZmccLabSessions", fields: [zmcc_id], references: [id], onDelete: Restrict)
  mot_arrival            ZmccMotArrival?           @relation("MotArrivalLabSession", fields: [mot_arrival_id], references: [id], onDelete: Restrict)
  local_supplier_arrival ZmccLocalSupplierArrival? @relation("LocalSupplierArrivalLabSession", fields: [local_supplier_arrival_id], references: [id], onDelete: Restrict)
  starter                User                      @relation("ZmccLabStartedBy", fields: [started_by_user_id], references: [id], onDelete: Restrict)
  completer              User?                     @relation("ZmccLabCompletedBy", fields: [completed_by_user_id], references: [id], onDelete: Restrict)
  last_corrector         User?                     @relation("ZmccLabLastCorrectedBy", fields: [last_corrected_by_user_id], references: [id], onDelete: Restrict)
  attendant_recommender  User?                     @relation("ZmccLabAttendantRecommendationBy", fields: [attendant_recommended_by_user_id], references: [id], onDelete: Restrict)
  final_decider          User?                     @relation("ZmccLabFinalDecisionBy", fields: [final_decided_by_user_id], references: [id], onDelete: Restrict)
  manager_reviewer       User?                     @relation("ZmccSessionReviewedBy", fields: [manager_reviewed_by_user_id], references: [id])
  manager_requester      User?                     @relation("ZmccSessionReviewRequestedBy", fields: [manager_review_requested_by_user_id], references: [id])
  results                ZmccLabResult[]
  tank_receipt           ZmccTankReceipt?          @relation("ZmccLabSessionReceipt")
  local_supplier_rmr     LocalSupplierRmrIssuance? @relation("LocalSupplierRmrFinalSession")
  portions               ZmccLabPortion[]          @relation("ZmccLabSessionPortions")

  @@index([zmcc_id, status])
  @@index([status, created_at])
  @@index([manager_review_status])
  @@map("zmcc_lab_session")
}

model ZmccLabResult {
  id                      BigInt    @id @default(autoincrement())
  session_id              BigInt    @map("session_id")
  test_id                 BigInt    @map("test_id")
  test_code_snapshot      String    @map("test_code_snapshot") @db.VarChar(50)
  test_name_snapshot      String    @map("test_name_snapshot") @db.VarChar(150)
  result_type_snapshot    String    @map("result_type_snapshot") @db.VarChar(20)
  unit_snapshot           String?   @map("unit_snapshot") @db.VarChar(30)
  is_required_snapshot    Boolean   @default(true) @map("is_required_snapshot")
  display_order_snapshot  Int       @default(0) @map("display_order_snapshot")
  result_options_snapshot Json?     @map("result_options_snapshot")
  numeric_value           Decimal?  @map("numeric_value") @db.Decimal(10, 4)
  text_value              String?   @map("text_value") @db.VarChar(255)
  applied_rule_id         BigInt?   @map("applied_rule_id")
  applied_rule_version    Int?      @map("applied_rule_version")
  evaluation_status       String?   @map("evaluation_status") @db.VarChar(50)
  is_passed               Boolean?  @map("is_passed")
  evaluation_snapshot     Json?     @map("evaluation_snapshot")
  recorded_at             DateTime? @map("recorded_at") @db.Timestamp(6)
  created_at              DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at              DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  portion_id              BigInt?   @map("portion_id") // Phase 2; unique(session_id,test_id) -> unique(portion_id,test_id) deferred

  // Relations
  session      ZmccLabSession  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  lab_test     LabTest         @relation("ZmccLabTestResults", fields: [test_id], references: [id], onDelete: Restrict)
  applied_rule LabTestRule?    @relation("ZmccResultRule", fields: [applied_rule_id], references: [id], onDelete: Restrict)
  portion      ZmccLabPortion? @relation("ZmccPortionResults", fields: [portion_id], references: [id], onDelete: Cascade)

  @@unique([session_id, test_id])
  @@index([session_id])
  @@index([applied_rule_id])
  @@index([portion_id])
  @@map("zmcc_lab_result")
}

model ZmccLabPortion {
  id             BigInt  @id @default(autoincrement())
  lab_session_id BigInt  @map("lab_session_id")
  portion_number Int     @map("portion_number")
  client_uuid    String? @unique @map("client_uuid") @db.VarChar(64) // offline idempotency
  status         String  @default("TESTING") @map("status") @db.VarChar(30) // TESTING | PENDING_REVIEW | ACCEPTED | REJECTED | WEIGHED | LOADED

  // Quantity / quality
  quantity_value      Decimal?      @map("quantity_value") @db.Decimal(12, 2)
  quantity_unit       QuantityUnit? @map("quantity_unit")
  density             Decimal?      @map("density") @db.Decimal(6, 4)
  gross_liters        Decimal?      @map("gross_liters") @db.Decimal(12, 2)
  lr                  Decimal?      @map("lr") @db.Decimal(6, 2)
  fat                 Decimal?      @map("fat") @db.Decimal(5, 2)
  snf                 Decimal?      @map("snf") @db.Decimal(6, 2)
  ts                  Decimal?      @map("ts") @db.Decimal(6, 2)
  at_13ts_liters      Decimal?      @map("at_13ts_liters") @db.Decimal(12, 2)
  calculation_version String?       @map("calculation_version") @db.VarChar(20)

  // Decision rules (same column set as MotShopCollection)
  system_outcome        String?   @map("system_outcome") @db.VarChar(20) // PASS | FAIL
  person_decision       String?   @map("person_decision") @db.VarChar(20) // ACCEPT | REJECT
  decision_remarks      String?   @map("decision_remarks") @db.Text
  exception_reasons     Json?     @map("exception_reasons") @db.JsonB
  review_status         String    @default("NONE") @map("review_status") @db.VarChar(20) // NONE | PENDING | APPROVED | REJECTED
  reviewed_by_user_id   BigInt?   @map("reviewed_by_user_id")
  reviewed_as_role      String?   @map("reviewed_as_role") @db.VarChar(64)
  reviewed_is_delegated Boolean   @default(false) @map("reviewed_is_delegated")
  reviewed_at           DateTime? @map("reviewed_at") @db.Timestamp(6)
  review_remarks        String?   @map("review_remarks") @db.Text
  final_decision        String    @default("PENDING") @map("final_decision") @db.VarChar(20) // PENDING | ACCEPTED | REJECTED
  created_by_user_id    BigInt?   @map("created_by_user_id")
  performed_as_role     String?   @map("performed_as_role") @db.VarChar(64)
  is_delegated          Boolean   @default(false) @map("is_delegated")
  // Phase 4b: per-portion decision snapshot (policy version, per-test outcomes, photos) and decision time
  decision_details      Json?     @map("decision_details") @db.JsonB
  decided_at            DateTime? @map("decided_at") @db.Timestamp(6)

  // Weighing (MDO / PHE Operator and superiors)
  first_weight_kg            Decimal?      @map("first_weight_kg") @db.Decimal(12, 3)
  first_weight_at            DateTime?     @map("first_weight_at") @db.Timestamp(6)
  first_weight_by_user_id    BigInt?       @map("first_weight_by_user_id")
  first_weight_as_role       String?       @map("first_weight_as_role") @db.VarChar(64)
  first_weight_is_delegated  Boolean       @default(false) @map("first_weight_is_delegated")
  second_weight_kg           Decimal?      @map("second_weight_kg") @db.Decimal(12, 3)
  second_weight_at           DateTime?     @map("second_weight_at") @db.Timestamp(6)
  second_weight_by_user_id   BigInt?       @map("second_weight_by_user_id")
  second_weight_as_role      String?       @map("second_weight_as_role") @db.VarChar(64)
  second_weight_is_delegated Boolean       @default(false) @map("second_weight_is_delegated")
  net_entry_mode             String?       @map("net_entry_mode") @db.VarChar(10) // WEIGHT | MANUAL
  net_entry_value            Decimal?      @map("net_entry_value") @db.Decimal(12, 3)
  net_entry_unit             QuantityUnit? @map("net_entry_unit")
  net_weight_kg              Decimal?      @map("net_weight_kg") @db.Decimal(12, 3)

  tank_id    BigInt?  @map("tank_id")
  version    Int      @default(1) @map("version")
  created_at DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updated_at DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  lab_session    ZmccLabSession    @relation("ZmccLabSessionPortions", fields: [lab_session_id], references: [id], onDelete: Cascade)
  tank           ZmccTank?         @relation("ZmccTankPortions", fields: [tank_id], references: [id], onDelete: Restrict)
  creator        User?             @relation("ZmccLabPortionCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  reviewer       User?             @relation("ZmccLabPortionReviewedBy", fields: [reviewed_by_user_id], references: [id], onDelete: SetNull)
  first_weigher  User?             @relation("ZmccLabPortionFirstWeighedBy", fields: [first_weight_by_user_id], references: [id], onDelete: SetNull)
  second_weigher User?             @relation("ZmccLabPortionSecondWeighedBy", fields: [second_weight_by_user_id], references: [id], onDelete: SetNull)
  results        ZmccLabResult[]   @relation("ZmccPortionResults")
  receipts       ZmccTankReceipt[] @relation("ZmccPortionReceipts")

  @@unique([lab_session_id, portion_number])
  @@index([status])
  @@index([review_status])
  @@index([tank_id])
  @@map("zmcc_lab_portion")
}

model RejectedMilkDisposition {
  id                   BigInt   @id @default(autoincrement())
  stage                String   @map("stage") @db.VarChar(20) // ZMCC | PLANT
  entity_type          String   @map("entity_type") @db.VarChar(30) // ZMCC_LAB_PORTION | ZMCC_LAB_SESSION | VISIT_PORTION
  entity_id            BigInt   @map("entity_id")
  remarks              String   @map("remarks") @db.Text
  decided_by_user_id   BigInt   @map("decided_by_user_id")
