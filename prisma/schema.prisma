  deep_link         String?                @map("deep_link") @db.VarChar(500)
  source_type       String                 @map("source_type") @db.VarChar(80)
  source_id         String?                @map("source_id") @db.VarChar(100)
  dedupe_key        String                 @unique @map("dedupe_key") @db.VarChar(255)
  read_at           DateTime?              @map("read_at") @db.Timestamp(6)
  expires_at        DateTime?              @map("expires_at") @db.Timestamp(6)
  created_at        DateTime               @default(now()) @map("created_at") @db.Timestamp(6)
